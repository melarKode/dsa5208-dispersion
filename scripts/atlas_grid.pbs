#!/bin/bash
#PBS -N dispersion-grid
#PBS -q parallel
#PBS -l select=1:ncpus=12:mpiprocs=1:mem=16gb
#PBS -l walltime=00:30:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p logs
exec > >(tee "logs/atlas-grid-${PBS_JOBID}.log") 2>&1
source scripts/atlas_env.sh
module load Python/3.12.3-GCCcore-13.3.0
root="results/atlas-grid-${PBS_JOBID}"
mkdir -p "$root"
printf '%s  %s\n' f31c3ebad74affc026016c04069d14b7 data/raw/interpolated_cases.h5 | md5sum --check
.venv-atlas/bin/python scripts/probe_urban_grid.py data/raw/interpolated_cases.h5 --output "$root/grid-probe.json"
echo "SUCCESS: grid verification complete: $root"
