#!/bin/bash
#PBS -N dispersion-2node
#PBS -q auto
#PBS -P personal-e1538254
#PBS -l select=2:ncpus=12:mpiprocs=6:ompthreads=2:mem=16gb
#PBS -l place=scatter
#PBS -l walltime=01:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p logs
exec > >(tee "logs/vanda-multinode-${PBS_JOBID}.log") 2>&1
trap 'code=$?; if (( code )); then echo "FAILED: exit $code; retain log for diagnosis"; fi' EXIT
source scripts/vanda_env.sh
module load Python/3.12.3-GCCcore-13.3.0
export OMP_NUM_THREADS=2
root="results/vanda-multinode-${PBS_JOBID}"
mkdir -p "$root"
module list > "$root/modules.txt" 2>&1
cp "$PBS_NODEFILE" "$root/pbs-nodefile.txt"
qstat -f "$PBS_JOBID" > "$root/pbs-job.txt"
mpirun --version > "$root/mpi-version.txt"
g++ --version > "$root/compiler-version.txt"
.venv-multinode/bin/python -c 'import numpy; print("NumPy", numpy.__version__)'
manifest=SOURCE_SHA256SUMS
if [[ ! -f "$manifest" ]]; then
  manifest="$root/source-manifest.txt"
  awk '$2 ~ /^(src\/|include\/|configs\/|scripts\/|tests\/|CMakeLists.txt$)/' SHA256SUMS > "$manifest"
  [[ -s "$manifest" ]]
fi
sha256sum -c "$manifest" > "$root/source-checksums.txt"
[[ "$manifest" == "$root/"* ]] || cp "$manifest" "$root/"
if [[ -f KOKKOS_REVISION.txt ]]; then
  cp KOKKOS_REVISION.txt "$root/"
else
  git -C external/kokkos rev-parse HEAD > "$root/KOKKOS_REVISION.txt"
fi
build="build/vanda-${PBS_JOBID}"
cmake -S . -B "$build" -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_COMPILER=mpicxx \
  -DDISPERSION_BUILD_PARALLEL=ON -DKokkos_ENABLE_OPENMP=ON
cmake --build "$build" --parallel 6
ctest --test-dir "$build" --output-on-failure
.venv-multinode/bin/python -u scripts/run_multinode.py \
  --build "$build" --batch-script scripts/vanda_multinode.pbs --transport tcp --output "$root"
echo "SUCCESS: Vanda multi-node experiment complete: $root"
