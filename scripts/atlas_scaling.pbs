#!/bin/bash
#PBS -N dispersion-scaling
#PBS -q parallel
#PBS -l select=1:ncpus=12:mpiprocs=12:ompthreads=1:mem=16gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p logs
exec > >(tee "logs/atlas-scaling-${PBS_JOBID}.log") 2>&1
source scripts/atlas_env.sh
root="results/atlas-scaling-${PBS_JOBID}"
mkdir -p "$root"
module list > "$root/modules.txt" 2>&1
sort "$PBS_NODEFILE" | uniq -c > "$root/allocation.txt"
for repeat in 1 2 3; do
  OMP_NUM_THREADS=1 mpirun -np 1 --bind-to core -x LD_PRELOAD -x LD_LIBRARY_PATH \
    build/atlas-cpu/dispersion_serial configs/scaling.cfg "output_dir=$root/serial-$repeat"
  for threads in 1 2; do
    export OMP_NUM_THREADS="$threads"
    for ranks in 1 2 3 6 12; do
      if (( ranks * threads > 12 )); then continue; fi
      for decomposition in slab block; do
        for exchange in blocking overlap; do
          mpirun -np "$ranks" --map-by "slot:PE=$threads" --bind-to core --report-bindings \
            -x LD_PRELOAD -x LD_LIBRARY_PATH -x OMP_NUM_THREADS -x OMP_PLACES -x OMP_PROC_BIND -x OMP_DYNAMIC \
            build/atlas-cpu/dispersion_mpi configs/scaling.cfg \
            "output_dir=$root/r$ranks-t$threads-$decomposition-$exchange-$repeat" \
            "decomposition=$decomposition" "exchange=$exchange"
        done
      done
    done
  done
 done

module load Python/3.12.3-GCCcore-13.3.0
.venv-atlas/bin/python scripts/summarize_scaling.py "$root"
echo "SUCCESS: single-node scaling complete: $root"
